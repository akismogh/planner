# Loaded automatically when Vite builds with `--mode github`.
# Switches the data layer to browser localStorage (no server).
VITE_STORAGE=browser

# URL of the AI Insights relay worker (see /worker). Leave blank to hide the
# "AI Insights" panel entirely. Set after running `npx wrangler deploy` in
# /worker — see worker/README.md.
VITE_AI_WORKER_URL=https://retirement-planner-ai.akismo.workers.dev
